# Copy this file to .env only when you need to override a Compose default.
# The normal Docker Compose stack runs Ollama in the `ollama` service.
# Compose containers access the bind-mounted database at /data/librarian.db.
LIBRARIAN_DATABASE_URL=sqlite:////data/librarian.db
LIBRARIAN_LOG_FILE=/data/librarian.log
LIBRARIAN_BOOKS_DIR=/books
LIBRARIAN_HOST_BOOKS_DIR=./Epub-Books
LIBRARIAN_CODEX_BROKER_URL=http://host.docker.internal:8787
LIBRARIAN_ENABLE_CODEX_BROKER=false
LIBRARIAN_EMBEDDING_PROVIDER=ollama
LIBRARIAN_EMBEDDING_MODEL=all-minilm
LIBRARIAN_GENERATION_PROVIDER=ollama
LIBRARIAN_GENERATION_MODEL=qwen2.5:1.5b
LIBRARIAN_OLLAMA_BASE_URL=http://ollama:11434
LIBRARIAN_OPENSEARCH_URL=http://opensearch:9200
LIBRARIAN_OPENSEARCH_INDEX=librarian-chunks
# The Compose default is -Xms192m -Xmx192m, sized for a 2 GB Docker VM.
# Raise this only when Docker has sufficient memory for OpenSearch and Ollama.
LIBRARIAN_OPENSEARCH_JAVA_OPTS=-Xms192m -Xmx192m
